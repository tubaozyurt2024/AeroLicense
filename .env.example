# Bu dosyayı .env olarak kopyalayın ve değerleri değiştirin. .env git'e girmez (.gitignore).
POSTGRES_PASSWORD=degistir-beni
# En az 32 karakter. Üretmek için: openssl rand -base64 48
JWT_SIGNING_KEY=
# Belge imzası (HMAC) anahtarı, JWT anahtarından FARKLI olmalı. En az 32 karakter: openssl rand -base64 48
DOCUMENT_SIGNING_KEY=
# Seed kullanıcılarının ortak demo parolası (sadece kurgusal test verisi için)
SEED_DEMO_PASSWORD=Demo123!
